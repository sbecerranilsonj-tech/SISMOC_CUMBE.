# Copiar los NOMBRES en Railway > servicio web > Variables.
# Generar secretos nuevos en Railway. Este archivo no contiene credenciales reales.
DEBUG=False
SECRET_KEY=
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATA_DIR=/data
# Generar primero el dominio público del servicio.
# Si RAILWAY_PUBLIC_DOMAIN está disponible, el dominio se incorpora automáticamente.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
